# 이 파일을 복사해서 .env 로 만들고 값을 채우세요. (.env 는 git에 올리지 않아요)
#   Copy-Item .env.example .env      (맥/리눅스: cp .env.example .env)

# ── 1) DB ──────────────────────────────────────────────
# Neon의 "Copy connection strings"로 복사한 DATABASE_URL 줄을 그대로 붙여 넣으세요.
DATABASE_URL="postgresql://사용자:비밀번호@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ── 2) 인증 메일 ───────────────────────────────────────
# 아래 둘 중 하나를 쓰세요. 아무것도 안 채우면 개발 모드에서는 인증 코드가 서버 터미널에 출력돼요.
# (배포 환경(NODE_ENV=production)에서는 메일 설정이 없으면 서버가 시작되지 않아요.)

# [A] 내 컴퓨터에서 테스트: Gmail
#   구글 계정 → 보안 → 2단계 인증을 켠 뒤 → https://myaccount.google.com/apppasswords 에서 "앱 비밀번호" 생성
#   ※ Render 무료 서버는 SMTP 포트를 막아서 배포 환경에서는 쓸 수 없어요.
MAIL_PROVIDER=gmail
GMAIL_USER=내계정@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# [B] 배포: Resend (HTTPS API) — 인증한 도메인이 필요해요
# MAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=no-reply@내도메인.com

# 메일에 표시되는 서비스 이름 (선택)
# MAIL_FROM_NAME=당근 클론

# 로컬 포트 (배포 서비스는 자동으로 지정해 줘요)
PORT=3000
